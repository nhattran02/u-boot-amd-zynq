/*
 * Default environment for the AMD Zynq-7000 ZC702 board
 *
 * Load addresses used by bootstd (extlinux.conf, boot.scr, PXE) and by
 * manual "load ... ${kernel_addr_r} ..." commands. 1 GiB of DDR at 0:
 *
 *   0x01d00000  PXE config file
 *   0x01e00000  boot script
 *   0x01f00000  device tree (1 MiB)
 *   0x02000000  zImage (32 MiB, the kernel self-decompresses to 0x8000)
 *   0x04000000  initramfs
 */

kernel_addr_r=0x02000000
fdt_addr_r=0x01f00000
scriptaddr=0x01e00000
pxefile_addr_r=0x01d00000
ramdisk_addr_r=0x04000000
fdtfile=zynq-zc702.dtb

/* Keep the relocated DT and initrd inside the kernel's lowmem */
bootm_size=0x20000000
