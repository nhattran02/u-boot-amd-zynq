/*
 * AMD Zynq-7000 ZC702 evaluation board
 *
 * Board description: UG850
 */

/dts-v1/;

#include "amd-xilinx-zynq.dtsi"

/ {
	model = "AMD Zynq-7000 ZC702 (amd-zynq-soc)";
	compatible = "amd,zynq-soc-zc702", "xlnx,zynq-zc702",
		     "amd,xilinx-zynq", "xlnx,zynq-7000";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x40000000>;		/* 1 GiB DDR3 */
	};
};

&clkc {
	ps-clk-frequency = <33333333>;
};

/* USB-UART bridge (CP2103) */
&uart1 {
	status = "okay";
	bootph-all;
};
